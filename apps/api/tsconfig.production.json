{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "dist-production",
    "sourceMap": false
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "dist",
    "dist-production",
    "node_modules",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.fixture.ts",
    "src/**/*.typecheck.ts",
    "src/**/test/**",
    "src/**/tests/**",
    "src/**/__tests__/**",
    "src/**/fixtures/**",
    "src/**/__fixtures__/**",
    "src/**/test-helpers/**",
    "src/**/harness/**",
    "src/modules/max-adapter/fake.ts",
    "tests/**",
    "test-integration/**",
    "e2e/**"
  ]
}
