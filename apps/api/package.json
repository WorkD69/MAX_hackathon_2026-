    "fastify": "5.12.5",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "zod": "4.6.5",
    "@fastify/static": "10.1.4"
  },
  "devDependencies": {
    "kysely": "0.29.6"
  }
}
