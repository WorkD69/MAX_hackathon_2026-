# Все ENV_KEYS из apps/api/src/config/schema.ts. Секреты заполнить только в локальном .env.
APP_ENV=production
HOST=0.0.0.0
PORT=3000
APP_PORT=3000
DEMO_MODE=true
# Compose выводит DATABASE_URL из POSTGRES_*; вне Compose задать собственный URL.
DATABASE_URL=
APP_SESSION_SECRET=
MAX_ADAPTER_MODE=live
MAX_BOT_TOKEN=
MAX_WEBHOOK_SECRET=
PUBLIC_APP_URL=https://miniapp.example.invalid
PUBLIC_API_BASE_URL=https://api.example.invalid/api/v1
# Полный SHA чистого checkout, из которого собирается образ.
BUILD_SHA=
MAX_INIT_DATA_MAX_AGE_SECONDS=300
MAX_INIT_DATA_FUTURE_SKEW_SECONDS=30
APP_SESSION_TTL_SECONDS=900
MAX_REQUEST_TIMEOUT_MS=10000
MAX_SUBSCRIPTION_RECONCILE_INTERVAL_MS=300000
NOTIFICATION_WORKER_POLL_INTERVAL_MS=1000
NOTIFICATION_WORKER_CONCURRENCY=4
NOTIFICATION_RETRY_BASE_MS=1000
NOTIFICATION_RETRY_MAX_MS=300000
NOTIFICATION_LEASE_MS=30000
NOTIFICATION_MAX_ATTEMPTS=8
# TEST ONLY: оставить пустыми. Compose не передаёт эти ключи в приложение.
TEST_AUTH_DEMO_PROFILE=
TEST_MAX_INIT_DATA_SIGNING_KEY=

# Delivery keys, вне typed application schema. APP_PORT публикует только loopback хоста.
POSTGRES_USER=city
POSTGRES_DB=city
POSTGRES_PASSWORD=
# Только compose.vps.yaml устанавливает этот путь внутри контейнера.
NODE_EXTRA_CA_CERTS=
